# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local assistant memory
.memory/

# claude code local config / plans
.claude/

# assistant session artifacts (not app code)
/.firecrawl/
/.agents/
skills-lock.json

# python
__pycache__/
*.pyc

# local generated artifacts (167 MB of images, not app code)
/output/

# UI baseline screenshots (scripts/ui-snapshots.ts)
/ui-baseline/
