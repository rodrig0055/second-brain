# Neon Postgres connection string (Vercel > Storage > Neon, or neon.tech)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=replace-me
# Required on Vercel so Auth.js uses the public deployment URL for OAuth redirects
AUTH_TRUST_HOST=true

# Google OAuth client (console.cloud.google.com > APIs & Services > Credentials)
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://YOUR-DOMAIN.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=xxxxx.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=replace-me

# AI providers
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# First admin created by `npm run db:seed`
SEED_ADMIN_EMAIL=you@example.com

# SEO data tools (used by the SEO-team task templates) ----------------------
# Google service account JSON for BigQuery (the GSC bulk export). Paste the raw
# JSON or, easier on Vercel, base64-encode it: `base64 -i key.json`.
GCP_SERVICE_ACCOUNT_JSON=
# Falls back to project_id inside the JSON if unset.
GCP_PROJECT_ID=
# Maps brand slug -> BigQuery dataset holding its GSC export tables. Value may be
# a dataset string (site_url defaults to "sc-domain:<brand domain>") or an object
# { "dataset": "...", "siteUrl": "https://example.com/" } for URL-prefix props.
# Example: {"acme-florals":"searchconsole_acme","bloomly-sg":{"dataset":"gsc_bloomly_sg","siteUrl":"https://bloomly-sg.example/"}}
# NOTE: the GSC bulk export is not backfilled; data exists only from the day the
# export was created.
GSC_BQ_DATASETS=
# Ahrefs API v3 bearer token (https://ahrefs.com/api) — used by SERP Spy.
AHREFS_API_TOKEN=
# SendPulse email API — one account-wide permanent API key (Settings → API,
# format sp_apikey_…), used as a Bearer token. Shared across brands like the
# GA4 service account; each brand's connection scopes to campaigns whose sender
# email matches the brand's domain. No per-brand secrets.
SENDPULSE_API_KEY=
# Fallback when no permanent key is available: OAuth client credentials for the
# same account. The API key takes precedence when both are set.
SENDPULSE_CLIENT_ID=
SENDPULSE_CLIENT_SECRET=

# Firecrawl API key (https://firecrawl.dev) — now used ONLY by the agent's
# searchWeb tool. Page reads (Image Studio URL import, task-run URLs, the
# fetchWebPage tool, storefront sitemaps/feeds) use plain fetch + headless
# Chromium (Playwright) and need no key.
FIRECRAWL_API_KEY=

# Optional: local Chromium/Chrome binary for page reads in dev. Unset, local
# dev uses the installed Google Chrome; on Vercel @sparticuz/chromium is used.
CHROMIUM_EXECUTABLE_PATH=

# Meta Ads CLI — system user access token + ad account (Business Suite >
# Settings > Users > System Users > Generate New Token; scopes: ads_management,
# read_insights, pages_show_list, pages_read_engagement, pages_manage_ads,
# business_management, catalog_management).
ACCESS_TOKEN=
AD_ACCOUNT_ID=act_xxxxxxxxxxxx

# Internal authorization for the Python Meta Ads CLI function. Optional when
# CRON_SECRET is set; a dedicated value is recommended in production.
META_CLI_INTERNAL_SECRET=
# Full endpoint override for local development or a separately deployed Python
# function, e.g. https://meta-cli.example.com/api/meta-insights.
META_CLI_URL=
# CLI subprocess timeout and warm-instance cache duration.
META_CLI_TIMEOUT_SECONDS=20
META_CLI_CACHE_TTL_SECONDS=120

# Shared secret for the scheduled-task cron endpoint. Vercel Cron sends it as
# `Authorization: Bearer $CRON_SECRET`. Generate with: openssl rand -base64 32
CRON_SECRET=replace-me

# Integration credential encryption (AES-256-GCM). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATIONS_ENC_KEY=

# Object storage (src/lib/storage). Any S3-compatible bucket (Cloudflare R2 works
# well and has free egress). Leave STORAGE_BACKEND unset to use Vercel Blob.
STORAGE_BACKEND=
STORAGE_BUCKET=second-brain-media
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_PUBLIC_BASE_URL=https://pub-example.r2.dev
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Vercel Blob, the default backend when STORAGE_BACKEND is unset.
BLOB_READ_WRITE_TOKEN=

# Meta Ads write actions (pause, activate, upload a paused ad).
# Two gates, both required: this, and writeEnabled on the individual ad account
# in Admin -> Integrations. Off means the workspace shows Ads Manager links
# instead of buttons.
ADS_WRITES_ENABLED=

# TikTok for Business developer app (one app serves every brand, organic + ads).
# TikTok for Business -> My Apps -> App Detail -> Basic Information.
# Register https://<app>/api/integrations/tiktok/callback/ (trailing slash) as BOTH
# the "TikTok account holder redirect URL" and the "Advertiser redirect URL".
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
# Copied verbatim from App Detail; the app only appends `state`.
TIKTOK_ACCOUNT_AUTH_URL=
TIKTOK_ADVERTISER_AUTH_URL=
# URL prefixes TikTok has verified you own (comma-separated). TikTok only
# publishes media from these.
TIKTOK_MEDIA_PREFIXES=

# Google Merchant Center accounts per brand slug (JSON). Unset turns the
# Merchant Center tools off.
# MERCHANT_CENTER_ACCOUNTS={"acme-florals":[{"id":"1234567","label":"Acme Florals","live":true}]}
MERCHANT_CENTER_ACCOUNTS=
