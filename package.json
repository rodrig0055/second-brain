{
  "name": "second-brain",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:meta": "tsx --test src/lib/integrations/meta/*.test.ts && python3 -m unittest tests/test_meta_insights.py",
    "check:ads:store": "tsx --env-file=.env.local --require ./scripts/_server-only-shim.cjs scripts/check-ads-store.ts",
    "check:ads:rules": "tsx --env-file=.env.local --require ./scripts/_server-only-shim.cjs scripts/check-ads-rules.ts",
    "check:ads:actions": "tsx scripts/check-meta-action-types.ts",
    "check:schema": "tsx scripts/check-schema-drift.ts",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "check:social": "tsx --env-file=.env.local scripts/check-social-claim.ts",
    "check:workspaces": "tsx --env-file=.env.local --require ./scripts/_server-only-shim.cjs scripts/check-workspaces.ts",
    "check:ads:accounts": "tsx --env-file=.env.local --require ./scripts/_server-only-shim.cjs scripts/check-account-guard.ts",
    "fix:meta-account": "tsx --env-file=.env.local --require ./scripts/_server-only-shim.cjs scripts/repoint-meta-account.ts",
    "check:ads:entities": "tsx --env-file=.env.local --require ./scripts/_server-only-shim.cjs scripts/check-ads-entities.ts",
    "rotate:enc-key": "tsx --env-file=.env.local scripts/rotate-integration-key.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.127",
    "@ai-sdk/google": "^3.0.82",
    "@ai-sdk/openai": "^3.0.110",
    "@ai-sdk/react": "^3.0.203",
    "@astryxdesign/core": "^0.7.11",
    "@astryxdesign/theme-neutral": "^0.7.11",
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1139.0",
    "@google-analytics/data": "^6.1.0",
    "@google-cloud/bigquery": "^8.3.1",
    "@mozilla/readability": "0.6.0",
    "@neondatabase/serverless": "^1.1.0",
    "@sparticuz/chromium": "153.0.0",
    "@stylexjs/stylex": "^0.19.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.4.0",
    "@vercel/functions": "^3.7.5",
    "ai": "^6.0.201",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.9.3",
    "linkedom": "0.18.13",
    "lucide-react": "^1.23.0",
    "mysql2": "^3.24.4",
    "next": "16.2.9",
    "next-auth": "^5.0.0-beta.31",
    "playwright-core": "1.63.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.0",
    "sharp": "^0.34.5",
    "simple-icons": "^16.34.0",
    "streamdown": "^2.5.0",
    "turndown": "7.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.11",
    "@stylexswc/nextjs-plugin": "^0.20.0",
    "@stylexswc/postcss-plugin": "^0.20.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/turndown": "^5.0.6",
    "axe-core": "^4.14.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
